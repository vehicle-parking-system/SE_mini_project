{
  "name": "vps-acceptance-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Automated API, security and performance tests for the Vehicle Parking System, derived from the Software Test Plan",
  "scripts": {
    "test": "jest",
    "test:ci": "mkdir -p results && jest --ci --json --outputFile=results/jest-results.json",
    "rtm": "node rtm-report.js results/jest-results.json"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "maxWorkers": 1
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb": "^6.10.0"
  }
}
